APP_NAME=tayog-scraper
ENV=production
DEBUG=false

MONGODB_URL=mongodb://tayog:tayog_secret@mongodb:27017/tayog_scraper?authSource=admin
MONGODB_DB=tayog_scraper

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

PLAYWRIGHT_HEADLESS=true
LOG_LEVEL=INFO

SCRAPER_CONCURRENCY=8
SCRAPER_DELAY=1.5
MAX_RETRY_ATTEMPTS=3